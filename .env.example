# ═══════════════════════════════════════════════════════════════════
# Debug Together — Frontend Environment Configuration
# Copy this file to .env and fill in all values marked with <REQUIRED>
# All variables MUST be prefixed with VITE_ to be exposed to the browser.
# ═══════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
VITE_APP_NAME="Debug Together"
VITE_APP_ENV=development          # development | production

# ── API ───────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1   # <REQUIRED> Laravel backend URL

# ── Stripe ────────────────────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_             # <REQUIRED> Publishable key ONLY
VITE_STRIPE_PRICE_FREE=price_free
VITE_STRIPE_PRICE_PRO_MONTHLY=price_            # <REQUIRED> From Stripe Dashboard

# ── Feature Flags ─────────────────────────────────────────────────────────────
VITE_FEATURE_SHARING=true
VITE_FEATURE_BILLING=true
VITE_FEATURE_PDF_EXPORT=true

# ── Analytics / Monitoring ────────────────────────────────────────────────────
VITE_SENTRY_DSN=                  # Optional — https://sentry.io (browser SDK)
VITE_POSTHOG_KEY=                 # Optional — https://posthog.com

# ── Supported platforms (comma-separated, must match backend enum) ─────────────
VITE_SUPPORTED_PLATFORMS=instagram,whatsapp
